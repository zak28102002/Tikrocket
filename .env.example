# ── Core ─────────────────────────────────────────────
DATABASE_URL="postgresql://pulse:pulse@localhost:5432/pulse"
# Public origin of the app, used for CSRF origin checks and invite links.
APP_URL="http://localhost:3000"
# Shared secret for /api/cron/tick (serverless hosts without a worker process).
CRON_SECRET=""

# ── Demo mode (UI development only) ─────────────────
# Registers the mock connector. It is only ever used by workspaces flagged isDemo.
PULSE_ENABLE_DEMO="false"

# ── YouTube (official Data API v3) ──────────────────
YOUTUBE_API_KEY=""

# ── Instagram (Graph API · Business Discovery) ──────
# Your own Instagram Business/Creator account id + a long-lived token with
# instagram_basic & pages_read_engagement. Target profiles must be Business/Creator.
META_IG_BUSINESS_ACCOUNT_ID=""
META_ACCESS_TOKEN=""
META_GRAPH_VERSION="v21.0"

# ── TikTok (pluggable licensed data provider) ───────
# Leave TIKTOK_PROVIDER empty to show TikTok metrics as "Data unavailable".
# Supported: "http" (generic JSON provider adapter, see src/server/connectors/tiktok/providers)
TIKTOK_PROVIDER=""
TIKTOK_PROVIDER_BASE_URL=""
TIKTOK_PROVIDER_API_KEY=""

# ── Worker ──────────────────────────────────────────
WORKER_CONCURRENCY="3"
