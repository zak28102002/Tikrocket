# --- Required -----------------------------------------------------------------
# Postgres connection string (Railway: reference the Postgres plugin's DATABASE_URL)
DATABASE_URL=postgres://user:pass@host:5432/flavwak_spin
# The store's permanent myshopify domain (Settings → Domains), not flavwak.com
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
# Dev Dashboard app credentials (App settings → Credentials). The client secret is
# also what Shopify uses to sign App Proxy requests.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Long random string (>= 32 chars) that signs visitor ids and hashes IPs.
# Generate with: openssl rand -base64 48   — keep it stable across deploys.
SPIN_VISITOR_SECRET=

# --- Optional -----------------------------------------------------------------
# Use a static Admin API token instead of the client credentials grant.
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_...
# SHOPIFY_API_VERSION=2026-10
# Hours a won code stays valid (default 48)
# SPIN_CODE_VALID_HOURS=48
# One spin per visitor / customer within this many days (default 30)
# SPIN_COOLDOWN_DAYS=30
# Spins allowed per IP per 24 h, limits clearing storage to re-spin (default 5, 0 = off)
# SPIN_MAX_SPINS_PER_IP_PER_DAY=5
# Lock a logged-in winner's code to their customer account (default true)
# SPIN_LOCK_CODE_TO_CUSTOMER=true
# Allow free-shipping discounts to combine with the spin code (default true)
# SPIN_COMBINES_WITH_SHIPPING=true
# Override the odds without a deploy (must total 100; see src/prizes.ts)
# SPIN_PROBABILITIES={"p5":60,"p10":20,"p20":3,"p35":1,"none":16}
# Proxies between Shopify and this process that append to X-Forwarded-For (Railway: 1)
# SPIN_TRUSTED_PROXY_HOPS=1
# Local development only — never in production:
# SPIN_ALLOW_UNSIGNED=false
