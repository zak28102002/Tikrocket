{{ 'flavwak.css' | asset_url | stylesheet_tag }}
<script src="{{ 'flavwak.js' | asset_url }}" defer></script>
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign flavor = product.title | remove: 'One Pack ' | remove: ' Miswak' | strip
  assign unit = current_variant.price
  assign full2 = unit | times: 2
  assign full3 = unit | times: 3
  comment
    Multi-pack savings are the automatic discounts, set here in store-currency pence.
    In the store currency they are used as-is; for other currencies they are scaled by
    the price ratio to the store-currency single-pack price (base_price).
  endcomment
  if cart.currency.iso_code == shop.currency
    assign save2 = section.settings.save_2 | times: 1
    assign save3 = section.settings.save_3 | times: 1
  else
    assign base = section.settings.base_price | times: 1
    assign save2 = unit | times: section.settings.save_2 | divided_by: base
    assign save3 = unit | times: section.settings.save_3 | divided_by: base
  endif
  assign total2 = full2 | minus: save2
  assign total3 = full3 | minus: save3
  assign per2 = total2 | divided_by: 2
  assign per3 = total3 | divided_by: 3

  comment
    Was prices come from the variant compare-at price set in Shopify admin. Without one,
    multi-packs compare against buying single packs.
  endcomment
  assign was_unit = unit
  if current_variant.compare_at_price > unit
    assign was_unit = current_variant.compare_at_price
  endif
  assign was1 = was_unit
  assign was2 = was_unit | times: 2
  assign was3 = was_unit | times: 3
  assign off1 = was1 | minus: unit | times: 100.0 | divided_by: was1 | round
  assign off2 = was2 | minus: total2 | times: 100.0 | divided_by: was2 | round
  assign off3 = was3 | minus: total3 | times: 100.0 | divided_by: was3 | round
  assign thumb = product.featured_media | default: product.featured_image
  assign sticks = section.settings.sticks_per_pack
  assign form_id = 'FwForm-' | append: section.id
  assign main_id = 'FwMain-' | append: section.id
  assign main_alt = product.featured_media.alt | default: product.title | escape
-%}

<section class="fw fw-bg-white fw-pdp">
  <div class="fw-wrap fw-pdp__grid">
    <div class="fw-pdp__gallery">
      <div class="fw-pdp__main fw-media">
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 1600 | image_tag:
              class: 'fw-img', id: main_id, loading: 'eager', fetchpriority: 'high',
              sizes: '(min-width: 900px) 55vw, 100vw', widths: '500, 800, 1100, 1600', alt: main_alt }}
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="fw-pdp__thumbs" role="list">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <button type="button" role="listitem" class="fw-pdp__thumb{% if forloop.first %} is-active{% endif %}"
                data-src="{{ media | image_url: width: 1600 }}" aria-label="Show image {{ forloop.index }}">
                {{ media | image_url: width: 160 | image_tag: class: 'fw-img', loading: 'lazy', alt: '' }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="fw-pdp__info">
      <p class="fw-eyebrow">Natural miswak · {{ flavor }}</p>
      <h1 class="fw-pdp__title">{{ flavor }} flavored miswak</h1>
      <p class="fw-pdp__sub">Ancient natural oral care with a {{ flavor | downcase }} experience. A toothbrush that grows on a tree: just peel, chew and brush.</p>

      <div class="fw-pdp__pack">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 8 12 3 3 8v8l9 5 9-5V8Z"/><path d="m3 8 9 5 9-5M12 13v8"/></svg>
        <span>Each pack contains <strong>{{ sticks }} natural miswak sticks</strong>.</span>
      </div>

      {%- assign flavors = section.settings.flavor_products -%}
      {%- if flavors.size > 1 -%}
        <p class="fw-pdp__label">Flavor <span>{{ flavor }}</span></p>
        <div class="fw-flavor-pills">
          {%- for f in flavors -%}
            {%- assign fname = f.title | remove: 'One Pack ' | remove: ' Miswak' | strip -%}
            <a href="{{ f.url }}" class="fw-flavor-pill{% if f.id == product.id %} is-active{% endif %}{% unless f.available %} is-soldout{% endunless %}"
               {% if f.id == product.id %}aria-current="page"{% endif %}>{{ fname }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- form 'product', product, id: form_id, novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        <input type="hidden" name="quantity" value="3" data-fw-qty>
        <fieldset id="fw-buy" data-fw-hide-sticky class="fw-qty" style="border:0;padding:0;margin:0 0 18px">
          <legend class="fw-pdp__label" style="width:100%">Choose your pack</legend>
          {% render 'fw-flash-sale' %}
          {%- liquid
            capture thumb_img
              if thumb
                echo thumb | image_url: width: 160 | image_tag: class: 'fw-img', loading: 'lazy', alt: ''
              endif
            endcapture
          -%}
          {%- for n in (1..3) -%}
            {%- liquid
              case n
                when 1
                  assign now = unit
                  assign was = was1
                  assign off = off1
                  assign per = unit
                  assign tag = ''
                when 2
                  assign now = total2
                  assign was = was2
                  assign off = off2
                  assign per = per2
                  assign tag = 'Most popular'
                when 3
                  assign now = total3
                  assign was = was3
                  assign off = off3
                  assign per = per3
                  assign tag = 'Best value'
              endcase
            -%}
            <label class="fw-qty__opt{% if n == 3 %} is-active{% endif %}">
              {%- if tag != blank -%}<span class="fw-qty__tag{% if n == 3 %} fw-qty__tag--best{% endif %}">{{ tag }}</span>{%- endif -%}
              <input type="radio" name="fw_qty" value="{{ n }}"{% if n == 3 %} checked{% endif %} data-total="{{ now | money }}">
              <span class="fw-qty__thumb" data-count="{{ n }}" aria-hidden="true">
                {%- for i in (1..n) -%}<span class="fw-qty__thumb-img">{{ thumb_img }}</span>{%- endfor -%}
              </span>
              <span class="fw-qty__main">
                <span class="fw-qty__name">{{ n }} pack{% if n > 1 %}s{% endif %}</span>
                <span class="fw-qty__meta">{{ per | money }} per pack · {{ sticks | times: n }} sticks</span>
              </span>
              <span class="fw-qty__price">
                <span class="fw-qty__now">{{ now | money }}</span>
                {%- if was > now -%}
                  <span class="fw-qty__was"><span class="visually-hidden">Was </span>{{ was | money }}</span>
                  <span class="fw-qty__off">−{{ off }}%</span>
                {%- endif -%}
              </span>
              <span class="fw-qty__perk">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                Free UK shipping
              </span>
            </label>
          {%- endfor -%}
        </fieldset>

        <button type="submit" name="add" class="fw-btn fw-btn--solid fw-btn--block fw-pdp__atc" {% unless current_variant.available %}disabled{% endunless %}>
          {%- if current_variant.available -%}
            Add to cart · <span data-fw-total>{{ total3 | money }}</span>
          {%- else -%}
            Back soon
          {%- endif -%}
        </button>
        <p class="fw-footnote" style="color:var(--fw-muted);margin-top:10px">Multi-pack savings apply automatically at checkout, also when you mix flavors.</p>
      {%- endform -%}

      <div class="fw-pdp__trust">
        <div><strong>Natural wood</strong>Salvadora persica</div>
        <div><strong>No nylon</strong>bristles</div>
        <div><strong>Free UK shipping</strong>Europe from €50</div>
      </div>

      {%- if section.settings.show_description and product.description != blank -%}
        <div class="fw-pdp__desc">{{ product.description }}</div>
      {%- endif -%}
    </div>
  </div>
  <script type="application/ld+json">{{ product | structured_data }}</script>
</section>

<script>
  (function () {
    var root = document.getElementById('FwForm-{{ section.id }}');
    if (!root) return;
    var total = root.querySelector('[data-fw-total]');
    var qty = root.querySelector('[data-fw-qty]');
    root.addEventListener('submit', function () {
      root.querySelectorAll('input[name="quantity"]:not([data-fw-qty])').forEach(function (el) { el.remove(); });
    }, true);
    root.querySelectorAll('input[name="fw_qty"]').forEach(function (input) {
      input.addEventListener('change', function () {
        if (qty) qty.value = input.value;
        root.querySelectorAll('.fw-qty__opt').forEach(function (o) { o.classList.remove('is-active'); });
        input.closest('.fw-qty__opt').classList.add('is-active');
        if (total) total.textContent = input.dataset.total;
      });
    });
    var main = document.getElementById('FwMain-{{ section.id }}');
    document.querySelectorAll('#shopify-section-{{ section.id }} .fw-pdp__thumb').forEach(function (b) {
      b.addEventListener('click', function () {
        if (!main) return;
        main.removeAttribute('srcset');
        main.src = b.dataset.src;
        document.querySelectorAll('#shopify-section-{{ section.id }} .fw-pdp__thumb').forEach(function (x) { x.classList.remove('is-active'); });
        b.classList.add('is-active');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "FW Product buy box",
  "settings": [
    { "type": "product_list", "id": "flavor_products", "label": "Flavors to show", "limit": 8 },
    { "type": "number", "id": "sticks_per_pack", "label": "Sticks per pack", "default": 3 },
    { "type": "number", "id": "base_price", "label": "Single-pack price in store currency (pence)", "default": 990 },
    { "type": "number", "id": "save_2", "label": "Saving on 2 packs (in pence, must match the automatic discount)", "default": 180 },
    { "type": "number", "id": "save_3", "label": "Saving on 3 packs (in pence, must match the automatic discount)", "default": 470 },
    { "type": "checkbox", "id": "show_description", "label": "Show product description", "default": false }
  ]
}
{% endschema %}
