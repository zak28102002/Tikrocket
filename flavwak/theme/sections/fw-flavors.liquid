{{ 'flavwak.css' | asset_url | stylesheet_tag }}
<section class="fw fw-bg-ivory fw-section" id="flavors">
  <div class="fw-wrap">
    <div class="fw-center fw-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="fw-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="fw-h2">{{ section.settings.heading }}</h2>
      <p class="fw-lead">{{ section.settings.text }}</p>
      {% render 'fw-flash-sale' %}
    </div>
    <div class="fw-flavors fw-reveal">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p == blank -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign flavor = block.settings.flavor | default: p.title
          assign desc = block.settings.description
        -%}
        <a class="fw-flavor{% unless p.available %} is-soldout{% endunless %}" href="{{ p.url }}" {{ block.shopify_attributes }}>
          <div class="fw-flavor__media">
            {%- if p.featured_media -%}
              {{ p.featured_media | image_url: width: 800 | image_tag: class: 'fw-img', loading: 'lazy', sizes: '(min-width: 900px) 20vw, 50vw', widths: '300, 500, 800', alt: p.title }}
            {%- endif -%}
            {%- unless p.available -%}<span class="fw-flavor__badge">Back soon</span>{%- endunless -%}
          </div>
          <div class="fw-flavor__body">
            <h3 class="fw-flavor__name">{{ flavor }}</h3>
            {%- if desc != blank -%}<p class="fw-flavor__desc">{{ desc }}</p>{%- endif -%}
            <div class="fw-flavor__row">
              <span class="fw-flavor__price">
                {{ p.price | money }}
                {% if p.compare_at_price > p.price -%}
                  {%- assign off = p.compare_at_price | minus: p.price | times: 100.0 | divided_by: p.compare_at_price | round -%}
                  <s class="fw-flavor__was"><span class="visually-hidden">Was </span>{{ p.compare_at_price | money }}</s>
                  <span class="fw-flavor__off">−{{ off }}%</span>
                {%- endif -%}
              </span>
              <span class="fw-flavor__cta">{% if p.available %}Choose flavor{% else %}View{% endif %}</span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="fw-footnote fw-center" style="color:var(--fw-muted)">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "FW Flavor grid",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Same natural miswak" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your favorite miswak." },
    { "type": "text", "id": "text", "label": "Text", "default": "Same natural miswak. Different ways to enjoy it." },
    { "type": "text", "id": "note", "label": "Note", "default": "Each pack contains 3 natural miswak sticks. Save when you buy 2 or 3 packs." }
  ],
  "blocks": [
    { "type": "flavor", "name": "Flavor", "settings": [
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "text", "id": "flavor", "label": "Flavor name" },
      { "type": "text", "id": "description", "label": "Short description" }
    ]}
  ],
  "presets": [{ "name": "FW Flavor grid" }]
}
{% endschema %}
