{{ 'flavwak.css' | asset_url | stylesheet_tag }}
<script src="{{ 'flavwak.js' | asset_url }}" defer></script>
{%- liquid
  assign anchor = section.settings.anchor | default: section.id
  assign filled = 0
  for block in section.blocks
    if block.settings.video != blank or block.settings.asset != blank
      assign filled = filled | plus: 1
    endif
  endfor

  comment
    Customers only ever see real videos: empty slots are skipped on the storefront and
    shown as placeholders in the theme editor only (unless "Show placeholders" is on).
  endcomment
  assign show_empty = false
  if request.design_mode or section.settings.show_placeholders_live
    assign show_empty = true
  endif
  assign count = filled
  if show_empty
    assign count = section.blocks.size
  endif

  if template.name == 'product'
    assign cta_href = section.settings.cta_link | default: '#fw-buy'
  else
    assign cta_href = section.settings.cta_link | default: '/#flavors'
  endif
-%}

{%- if count > 0 -%}
  <section
    class="fw fw-{{ section.settings.bg }} fw-section fw-videos{% if count == 1 %} fw-videos--feature{% endif %}"
    id="{{ anchor }}"
    aria-labelledby="FwVideosHeading-{{ section.id }}"
    data-fw-videos-autoplay="{{ section.settings.autoplay }}"
  >
    <div class="fw-wrap">
      <div class="fw-videos__layout">
        <div class="fw-videos__intro fw-reveal">
          {%- if section.settings.eyebrow != blank -%}<p class="fw-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="fw-h2" id="FwVideosHeading-{{ section.id }}">{{ section.settings.heading }}</h2>
          {%- if section.settings.text != blank -%}<p class="fw-lead">{{ section.settings.text }}</p>{%- endif -%}
        </div>

        <ul class="fw-videos__track fw-reveal" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              assign has_video = false
              if block.settings.video != blank or block.settings.asset != blank
                assign has_video = true
              endif
            -%}
            {%- if has_video or show_empty -%}
              <li class="fw-videos__item" {{ block.shopify_attributes }}>
                <figure class="fw-videos__card">
                  <div class="fw-videos__frame">
                    {%- if has_video -%}
                      {%- liquid
                        assign label = block.settings.heading | default: section.settings.heading | escape
                        if block.settings.poster != blank
                          assign poster_url = block.settings.poster | image_url: width: 720
                        elsif block.settings.poster_asset != blank
                          assign poster_url = block.settings.poster_asset | asset_url
                        elsif block.settings.video != blank and block.settings.video.preview_image
                          assign poster_url = block.settings.video.preview_image | image_url: width: 720
                        else
                          assign poster_url = ''
                        endif
                      -%}
                      <video
                        class="fw-videos__video"
                        muted
                        loop
                        playsinline
                        preload="none"
                        {% if poster_url != blank %}poster="{{ poster_url }}"{% endif %}
                        aria-label="{{ label }}"
                        data-fw-video
                      >
                        {%- if block.settings.video != blank -%}
                          {%- liquid
                            assign mp4 = nil
                            for source in block.settings.video.sources
                              if source.format == 'm3u8'
                                echo '<source src="' | append: source.url | append: '" type="' | append: source.mime_type | append: '">'
                              elsif source.format == 'mp4' and source.height <= 1280
                                if mp4 == nil or source.height > mp4.height
                                  assign mp4 = source
                                endif
                              endif
                            endfor
                          -%}
                          {%- if mp4 -%}<source src="{{ mp4.url }}" type="{{ mp4.mime_type }}">{%- endif -%}
                        {%- else -%}
                          <source src="{{ block.settings.asset | asset_url }}" type="video/mp4">
                        {%- endif -%}
                      </video>
                      <button type="button" class="fw-videos__tap" data-fw-video-sound aria-pressed="false" aria-label="Turn sound on">
                        <span class="fw-videos__hint" data-fw-video-hint>
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><path d="m23 9-6 6M17 9l6 6"/></svg>
                          <span>Tap for sound</span>
                        </span>
                      </button>
                      <span class="fw-videos__sound" aria-hidden="true">
                        <svg class="fw-videos__icon-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><path d="m23 9-6 6M17 9l6 6"/></svg>
                        <svg class="fw-videos__icon-on" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"/></svg>
                      </span>
                      <button type="button" class="fw-videos__pause" data-fw-video-pause aria-label="Pause video">
                        <svg class="fw-videos__icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4h4v16H6zM14 4h4v16h-4z"/></svg>
                        <svg class="fw-videos__icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"/></svg>
                      </button>
                    {%- else -%}
                      <div class="fw-videos__placeholder" role="img" aria-label="Video {{ forloop.index }} coming soon">
                        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m10 8 6 4-6 4V8Z" fill="currentColor" stroke="none"/></svg>
                        <span class="fw-videos__placeholder-label">Video {{ forloop.index }}</span>
                        <span class="fw-videos__placeholder-hint">9:16 vertical · add it in the theme editor</span>
                      </div>
                    {%- endif -%}
                  </div>
                  {%- if block.settings.heading != blank or block.settings.caption != blank -%}
                    <figcaption class="fw-videos__caption">
                      {%- if block.settings.heading != blank -%}<p class="fw-h3">{{ block.settings.heading }}</p>{%- endif -%}
                      {%- if block.settings.caption != blank -%}<p class="fw-p">{{ block.settings.caption }}</p>{%- endif -%}
                    </figcaption>
                  {%- endif -%}
                </figure>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if section.settings.cta_label != blank -%}
          <div class="fw-videos__cta fw-reveal">
            <a class="fw-btn fw-btn--solid" href="{{ cta_href }}">{{ section.settings.cta_label }}</a>
            {%- if section.settings.cta_note != blank -%}<p class="fw-footnote">{{ section.settings.cta_note }}</p>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "FW Vertical videos",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "videos" },
    { "type": "select", "id": "bg", "label": "Background", "default": "bg-white", "options": [
      { "value": "bg-ivory", "label": "Ivory" }, { "value": "bg-white", "label": "White" }, { "value": "bg-sand", "label": "Sand" }
    ]},
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "See it in action" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Miswak, in real life." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop miswak" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Default: the flavour picker on the homepage, the buy box on product pages." },
    { "type": "text", "id": "cta_note", "label": "Text under the button" },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Play muted on loop when visible",
      "info": "Sound starts only when a shopper taps the video. Visitors who prefer reduced motion get a play button instead.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_placeholders_live",
      "label": "Show empty slots on the storefront",
      "info": "Off: empty slots are only visible in the theme editor.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (9:16 vertical)", "info": "Upload under Content → Files, or pick here. Shopify hosts and optimises it." },
        { "type": "text", "id": "asset", "label": "…or theme asset file name", "info": "Used when no video is picked above, e.g. fw-ugc-1.mp4" },
        { "type": "image_picker", "id": "poster", "label": "Cover image (optional)" },
        { "type": "text", "id": "poster_asset", "label": "…or cover image theme asset", "info": "e.g. fw-ugc-1-poster.jpg" },
        { "type": "text", "id": "heading", "label": "Heading (optional)" },
        { "type": "text", "id": "caption", "label": "Caption (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FW Vertical videos",
      "blocks": [{ "type": "video" }, { "type": "video" }, { "type": "video" }]
    }
  ]
}
{% endschema %}
