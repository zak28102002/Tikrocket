{%- comment -%}
  Flash sale banner (Theme settings → Flash sale). With no end time it shows the sale
  without a countdown. With an end time it counts down to it and hides once it passes.
{%- endcomment -%}
{%- if settings.fw_flash_enabled -%}
  {%- if settings.fw_flash_end != blank -%}
    {%- assign fw_flash_end = settings.fw_flash_end | date: '%s' -%}
    <script src="{{ 'flavwak.js' | asset_url }}" defer></script>
    <div class="fw-flash" data-fw-flash data-end="{{ fw_flash_end | escape }}" hidden>
  {%- else -%}
    <div class="fw-flash fw-flash--open">
  {%- endif -%}
    <span class="fw-flash__label">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg>
      Flash sale
    </span>
    {%- if settings.fw_flash_text != blank -%}<span class="fw-flash__text">{{ settings.fw_flash_text | escape }}</span>{%- endif -%}
    {%- if settings.fw_flash_end != blank -%}
      <span class="fw-flash__timer">Ends in <span class="fw-flash__clock" data-fw-flash-clock>--:--:--</span></span>
    {%- endif -%}
  </div>
{%- endif -%}
